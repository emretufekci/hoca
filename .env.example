# Copy to .env (cp .env.example .env). Seven settings; everything else has a sensible default.

# Who writes the video: claude | codex | ollama | openai | anthropic
AGENT=claude

# Language of the video (on-screen text, voice and subtitles): en, tr, de, ...
LANGUAGE=en

# vertical (Reels, TikTok, Shorts) | landscape (YouTube) | square
VIDEO_FORMAT=vertical

# Length in seconds. Leave empty for 45 vertical, 120 landscape, 60 square.
VIDEO_DURATION=

# Spoken narration and on-screen subtitles: true | false
VOICEOVER=true
SUBTITLES=true

# Look of the animation. 3b1b = dark background, diagrams that draw themselves in.
# Add your own direction after it in plain words, e.g. 3b1b, warmer colors, playful
VIDEO_STYLE=3b1b

# Only if you need them:
# AGENT_MODEL=qwen2.5-coder:32b    model name, required for ollama and openai
# VOICEOVER_LANG=tr                speak a different language than LANGUAGE
# SUBTITLE_LANG=en                 subtitle a different language than the voice
# ANTHROPIC_API_KEY=               for AGENT=anthropic
# OPENAI_API_KEY=                  for AGENT=openai
# TTS_PROVIDER=antalia             voice; left unset, Hoca uses ema (EMA Lightning) for Turkish and kokoro for English
# More options (remote TTS, custom agents, resolution): see README.md
